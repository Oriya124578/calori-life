# Non-secret config for the `api` Cloud Function (Google Calendar OAuth).
# Copy to .env and adjust the domain if you use a custom one.
#
# Secrets (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET) are NOT set here — they are
# managed via Firebase Secret Manager:
#   firebase functions:secrets:set GOOGLE_CLIENT_ID
#   firebase functions:secrets:set GOOGLE_CLIENT_SECRET

# Must EXACTLY match an "Authorized redirect URI" on the OAuth 2.0 Web client.
GOOGLE_REDIRECT_URI=https://calori-life-app.web.app/auth/google/callback

# Where the OAuth callback sends the user back to after linking their account.
FRONTEND_URL=https://calori-life-app.web.app
